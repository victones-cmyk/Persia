# =============================================
# BANCO DE DADOS (Railway PostgreSQL)
# =============================================
DATABASE_URL="postgresql://usuario:senha@host.railway.internal:5432/persia_db"

# =============================================
# SESSÃO (express-session + connect-pg-simple)
# =============================================
SESSION_SECRET="troque-por-string-aleatoria-longa-minimo-64-caracteres"
# 8 horas em milissegundos
SESSION_MAX_AGE=28800000

# =============================================
# SEED — SENHAS INICIAIS (somente para rodar `npm run db:seed`)
# =============================================
# Senhas provisórias dos usuários criados no seed. Mínimo 8 caracteres.
# NUNCA usar senha real/definitiva aqui; o usuário é obrigado a trocá-la no 1º acesso.
SEED_ADMIN_SENHA="defina-uma-senha-provisoria-forte"
SEED_VENDEDOR_SP_SENHA="defina-uma-senha-provisoria-forte"
SEED_VENDEDOR_SBC_SENHA="defina-uma-senha-provisoria-forte"

# =============================================
# API GESTÃOCLICK
# =============================================
# Obtidas com Victor — BLOQUEANTE-01 resolvido em 11/06/2026. Preencher no .env real.
GESTAOCLICK_ACCESS_TOKEN="2dc2c358e31b4ba66de27c2311473e73260ab939"        # credenciais disponíveis — preencher no .env real
GESTAOCLICK_SECRET_ACCESS_TOKEN="2a560be911cbdf889b8de7f7cdca4826f3e99321" # credenciais disponíveis — preencher no .env real
GC_API_BASE_URL="https://api.gestaoclick.com"
GC_CLIENTE_URL_TEMPLATE="https://app.rainhadascortinas.com.br/clientes/editar/{id}"
# IDs das lojas no GestãoClick — PLACEHOLDER-01 RESOLVIDO em 11/06/2026
GC_LOJA_ID_SP="8274"   # Matriz (SP) — resolvido 11/06/2026
GC_LOJA_ID_SBC="8284"  # FILIAL SBC — resolvido 11/06/2026

# =============================================
# SERVIDOR
# =============================================
PORT=3001
NODE_ENV=development
# URL do frontend (para CORS em desenvolvimento)
FRONTEND_URL="http://localhost:5173"

# =============================================
# FEATURE FLAGS
# =============================================
# Habilita log detalhado das chamadas ao GestãoClick (true em dev, false em prod)
GC_DEBUG_LOG=false
# Timeout em ms para chamadas à API GestãoClick
GC_TIMEOUT_MS=10000

# =============================================
# IMPRESSÃO ZEBRA
# =============================================
# Preferencial: envio direto de ZPL por TCP, mais rápido que CUPS/lp.
ZEBRA_HOST=""
ZEBRA_PORT=9100
ZEBRA_TCP_TIMEOUT_MS=3000
ZEBRA_DPI=203
# Fallback antigo via CUPS, usado apenas se ZEBRA_HOST estiver vazio.
ZEBRA_PRINTER_NAME=""

# =============================================
# APP AGENDA (CurtainField) — vínculo de OS
# =============================================
# Mesmo servidor Postgres, database do app Agenda. Usuário restrito:
# SELECT em appointments/users + UPDATE apenas da coluna order_number.
# Vazio → integração desligada (o resto da Pérsia funciona normalmente).
AGENDA_DATABASE_URL=""
AGENDA_BASE_URL="https://agenda.texhaus.com.br"
