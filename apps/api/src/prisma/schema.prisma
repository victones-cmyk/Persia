// apps/api/src/prisma/schema.prisma
// Projeto Pérsia — modelo de dados (SRD §9)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Perfil {
  vendedor
  admin
  revenda
}

enum StatusOrcamento {
  rascunho
  enviado
  erro
  cancelado
}

enum StatusOrdemProducao {
  criada
  impressa
  cancelada
}

enum TipoProduto {
  persiana_rolo_blackout
  persiana_rolo_screen
  persiana_rolo_translucido
  persiana_rolo_double_vision
  persiana_romana_blackout
  persiana_romana_screen
  persiana_romana_translucido
  cortina
  misto
}

model Loja {
  id         String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  nome       String      @db.VarChar(50)
  gc_loja_id String?     @db.VarChar(50)
  ativo      Boolean     @default(true)
  usuarios   Usuario[]
  orcamentos Orcamento[]

  @@map("lojas")
}

model Usuario {
  id               String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  nome             String      @db.VarChar(100)
  email            String      @unique @db.VarChar(150)
  senha_hash       String      @db.VarChar(255)
  perfil           Perfil      @default(vendedor)
  loja_id          String?     @db.Uuid
  loja             Loja?       @relation(fields: [loja_id], references: [id])
  gc_usuario_id    String?     @db.VarChar(50)
  ativo            Boolean     @default(true)
  // true → senha definida pelo admin (provisória); usuário deve trocá-la no próximo login.
  senha_provisoria Boolean     @default(false)
  // Campos exclusivos do perfil revenda: cliente do GestãoClick ao qual o usuário
  // está atrelado (todo orçamento sai em nome dele), desconto embutido no preço de
  // venda e quais calculadoras a revenda pode acessar (vazio = nenhuma, por padrão).
  gc_cliente_vinculado_id   String?  @db.VarChar(50)
  gc_cliente_vinculado_nome String?  @db.VarChar(150)
  desconto_percentual       Decimal? @db.Decimal(5, 2)
  calculadoras_permitidas   String[] @default([])
  // Markup próprio da revenda (diferente do desconto: quem define e edita é ela
  // mesma, não o admin) — usado só para mostrar "preço sugerido ao cliente dela".
  markup_percentual         Decimal? @db.Decimal(5, 2)
  criado_em        DateTime    @default(now()) @db.Timestamptz
  atualizado_em    DateTime    @updatedAt @db.Timestamptz
  orcamentos       Orcamento[] @relation("OrcamentosVendedor")
  ordens_producao  OrdemProducao[]
  log_acoes        LogAcao[]

  @@map("usuarios")
}

model Orcamento {
  id                    String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tipo_produto          TipoProduto
  usuario_id            String          @db.Uuid
  usuario               Usuario         @relation("OrcamentosVendedor", fields: [usuario_id], references: [id])
  loja_id               String          @db.Uuid
  loja                  Loja            @relation(fields: [loja_id], references: [id])
  gc_orcamento_id       String?         @db.VarChar(50)
  gc_codigo             String?         @db.VarChar(50) // "código" enviado = Nº exibido no GestãoClick
  gc_pedido_id          String?         @db.VarChar(50)
  gc_pedido_codigo      String?         @db.VarChar(50)
  pedido_confirmado_em  DateTime?       @db.Timestamptz
  pedido_entrega_em     DateTime?       @db.Date
  gc_produto_id         String?         @db.VarChar(50)
  status                StatusOrcamento @default(rascunho)
  nome_cliente          String          @db.VarChar(150)
  gc_cliente_id         String?         @db.VarChar(50)
  tecido_codigo_gc      String          @db.VarChar(50)
  tecido_nome           String          @db.VarChar(100)
  largura_m             Decimal         @db.Decimal(6, 2)
  altura_m              Decimal         @db.Decimal(6, 2)
  dimensao_m            Decimal?        @db.Decimal(6, 2)
  tc_m                  Decimal?        @db.Decimal(6, 2)
  acionamento           String?         @db.VarChar(50)
  cor_acessorio         String?         @db.VarChar(20)
  rolamento             String?         @db.VarChar(20)
  valor_bruto           Decimal         @db.Decimal(10, 2)
  valor_final           Decimal         @db.Decimal(10, 2)
  // Snapshot dos itens (janelas) do orçamento — orçamento pode ter vários.
  // As colunas single acima guardam o 1º item (compat); a verdade dos N itens vive aqui.
  itens_json            Json?
  // Entrada bruta do formulário (inputs do vendedor) — permite reabrir um rascunho
  // na calculadora para edição. Persiana: { tipo, itens:[ItemInput], rt_pct }.
  // Cortina: { cortinas:[...], rt_pct }. Instalação e RT são por item.
  entrada_json          Json?
  payload_gc_enviado    Json?
  resposta_gc           Json?
  erro_gc               String?
  // Orcamento que este veio substituir, quando o vendedor recalculou com as
  // medidas do tecnico. Guarda o rastro que o cliente pediu: o antigo nao some,
  // vai para "Substituido" no GestaoClick e continua apontando para o que o
  // sucedeu. So e preenchido no recalculo — duplicar continua sendo copia solta.
  substitui_orcamento_id String?        @db.Uuid
  substitui              Orcamento?     @relation("OrcamentoSubstituicao", fields: [substitui_orcamento_id], references: [id])
  substituido_por        Orcamento[]    @relation("OrcamentoSubstituicao")
  criado_em             DateTime        @default(now()) @db.Timestamptz
  atualizado_em         DateTime        @updatedAt @db.Timestamptz
  ordens_producao       OrdemProducao[]
  agenda_vinculos       OrcamentoAgendaVinculo[]

  @@index([usuario_id, criado_em(sort: Desc)])
  @@index([status])
  @@index([gc_orcamento_id])
  @@index([substitui_orcamento_id])
  @@map("orcamentos")
}

// Vínculo com uma OS (appointment) do app Agenda (CurtainField) — outro app na
// mesma VPS/Postgres. NÃO tem FK de banco pro appointment (vive em outro
// database, curtainfield); agenda_appointment_id só referencia por id, lido
// ao vivo via conexão dedicada (AGENDA_DATABASE_URL) na hora de exibir.
model OrcamentoAgendaVinculo {
  id                    String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orcamento_id          String    @db.Uuid
  orcamento             Orcamento @relation(fields: [orcamento_id], references: [id])
  agenda_appointment_id Int
  // Snapshot do tipo no momento do vínculo (measurement/installation/return/warranty)
  // — não é a verdade atual (essa vem sempre ao vivo do Agenda), só contexto de log.
  tipo                  String    @db.VarChar(20)
  criado_por            String    @db.Uuid
  criado_em             DateTime  @default(now()) @db.Timestamptz

  @@unique([orcamento_id, agenda_appointment_id])
  @@index([orcamento_id])
  @@map("orcamento_agenda_vinculos")
}

model OrdemProducao {
  id                 String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  codigo             String              @unique @db.VarChar(30)
  orcamento_id       String              @db.Uuid
  orcamento          Orcamento           @relation(fields: [orcamento_id], references: [id])
  usuario_id         String              @db.Uuid
  usuario            Usuario             @relation(fields: [usuario_id], references: [id])
  item_index         Int
  gc_pedido_id       String?             @db.VarChar(50)
  gc_pedido_codigo   String              @db.VarChar(50)
  tipo_produto       TipoProduto
  status             StatusOrdemProducao @default(criada)
  item_snapshot_json Json
  criado_em          DateTime            @default(now()) @db.Timestamptz
  impresso_em        DateTime?           @db.Timestamptz
  // Marca que os materiais desta OS já baixaram do estoque no GestãoClick —
  // evita decrementar duas vezes se o botão for clicado de novo.
  baixado_estoque_em DateTime?           @db.Timestamptz

  @@unique([orcamento_id, item_index])
  @@index([orcamento_id])
  @@index([gc_pedido_codigo])
  @@map("ordens_producao")
}

model Configuracao {
  chave         String   @id @db.VarChar(100)
  valor         String
  descricao     String?  @db.VarChar(255)
  atualizado_em DateTime @updatedAt @db.Timestamptz

  @@map("configuracoes")
}

model GcProdutoLocal {
  id                String   @id @db.VarChar(50)
  nome              String   @db.VarChar(255)
  codigo_interno    String?  @db.VarChar(100)
  ativo             Boolean  @default(true)
  grupo_id          String?  @db.VarChar(50)
  nome_grupo        String?  @db.VarChar(150)
  largura           String?  @db.VarChar(50)
  valor_venda       Decimal  @default(0) @db.Decimal(12, 2)
  valores           Json?
  atributos         Json?
  raw_json          Json
  sincronizado_em   DateTime @db.Timestamptz
  criado_em         DateTime @default(now()) @db.Timestamptz
  atualizado_em     DateTime @updatedAt @db.Timestamptz

  @@index([grupo_id])
  @@index([codigo_interno])
  @@index([ativo])
  @@map("gc_produtos_locais")
}

model LogAcao {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  usuario_id String   @db.Uuid
  usuario    Usuario  @relation(fields: [usuario_id], references: [id])
  acao       String   @db.VarChar(100)
  detalhe    Json?
  criado_em  DateTime @default(now()) @db.Timestamptz

  @@map("log_acoes")
}
