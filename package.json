{
  "name": "persia",
  "version": "0.1.0",
  "private": true,
  "description": "Projeto Pérsia — plataforma de orçamento e integração comercial (Rainha das Cortinas / Stratos Lab)",
  "workspaces": [
    "apps/api",
    "apps/web"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "concurrently -n api,web -c blue,green \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "npm run dev --workspace apps/api",
    "dev:web": "npm run dev --workspace apps/web",
    "build": "npm run build --workspace apps/api && npm run build --workspace apps/web",
    "start": "npm run start --workspace apps/api",
    "db:local": "npm run db:local --workspace apps/api",
    "db:migrate": "npm run db:migrate --workspace apps/api",
    "db:seed": "npm run db:seed --workspace apps/api",
    "test": "npm run test --workspace apps/api"
  },
  "devDependencies": {
    "concurrently": "^9.1.0",
    "@types/node": "^20.17.10"
  },
  "overrides": {
    "esbuild": "^0.25.0",
    "vite": "^6.4.3"
  }
}
